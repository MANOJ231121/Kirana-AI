# --- TELEPHONY (Twilio) ---
# Get these from: https://console.twilio.com
# Account SID: Dashboard -> Account Info
TWILIO_ACCOUNT_SID=ACacd83cdb22e08e3e40eb9df5d1759825
# Auth Token: Dashboard -> Account Info
TWILIO_AUTH_TOKEN=bfce91ce02fbc55f4c8baf31a9a3114a
# Your Twilio phone number (E.164 format, e.g. +14155552671)
TWILIO_PHONE_NUMBER=+919675253351

# --- TEXT-TO-SPEECH (Rime TTS - MANDATORY) ---
# Get this from: https://app.rime.ai/tokens
RIME_API_KEY=f3Pi9HP2VoDGf93DxmlXT32Sq0HRC3zKTlzdNbrSj68
# Speaker voice: nadi (female) or taru (male)
RIME_SPEAKER=nadi

# --- SPEECH-TO-TEXT & LLM (Groq) ---
# Get this from: https://console.groq.com/keys
# Powers both Speech-To-Text (Groq Whisper) and LLM (llama-3.3)
GROQ_API_KEY=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
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- SPEECH-TO-TEXT (Optional Deepgram) ---
DEEPGRAM_API_KEY=

# --- DATABASE (MongoDB) ---
# MongoDB connection string (default is localhost)
MONGODB_URI=MONGODB_URI=mongodb://localhost:27017/KiranaStore

# --- SERVER ---
# Port for the Spring Boot application
SERVER_PORT=8080
# Your ngrok public URL (e.g. https://abc123.ngrok.io)
PUBLIC_BASE_URL=https://consuming-cake-favorite.ngrok-free.dev
# Seed sample inventory + demo customer on first boot (true/false)
SEED_DATA=true
