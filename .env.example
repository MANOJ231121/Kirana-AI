# ============================================
# KIRANA AI VOICE ORDERING (web app)
# Copy to .env — never commit .env
# ============================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/kirana_store

# --- Server ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Speech-to-text (backend only) ---
DEEPGRAM_API_KEY=

# --- LLM (backend only; GROQ_API_KEY or LLM_API_KEY) ---
GROQ_API_KEY=
LLM_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Text-to-speech (backend only) ---
RIME_API_KEY=
RIME_SPEAKER=nadi

# --- Shopkeeper portal auth (backend only) ---
SHOPKEEPER_USERNAME=shopkeeper
SHOPKEEPER_PASSWORD=changeme

# --- Seed demo data on first boot ---
SEED_DATA=true
