# ============================================
# KIRANA STORE VOICE ASSISTANT
# Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================

# --- TELEPHONY (Twilio) ---
# Get these from: https://console.twilio.com
# Account SID: Dashboard -> Account Info
TWILIO_ACCOUNT_SID=
# Auth Token: Dashboard -> Account Info
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (E.164 format, e.g. +14155552671)
TWILIO_PHONE_NUMBER=

# --- SPEECH-TO-TEXT (Deepgram) ---
# Get this from: https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- RIME TTS (MANDATORY) ---
# Get this from: https://app.rime.ai/tokens
RIME_API_KEY=
# Hindi speaker: nadi (female) or taru (male)
RIME_SPEAKER=nadi

# --- LLM (Groq) ---
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=

# --- DATABASE (MongoDB) ---
# MongoDB connection string (default is localhost)
MONGODB_URI=mongodb://localhost:27017/kirana_store

# --- SERVER ---
# Port for the Spring Boot application
SERVER_PORT=8080
# Your ngrok public URL (e.g. https://abc123.ngrok.io)
PUBLIC_BASE_URL=
# Seed sample inventory + demo customer on first boot (true/false)
SEED_DATA=true
